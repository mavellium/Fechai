# App / DB
# Local (fora do Docker, com `npm run db:up`): porta 5433 no host para não colidir
# com um Postgres local na 5432.
# Em docker-compose.yml: sobrescrito automaticamente para apontar pro serviço
# "postgres" da rede interna — não precisa editar pra rodar em produção.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas?schema=public"

# Auth (NextAuth / Auth.js v5)
NEXTAUTH_SECRET=""
# Em produção, use a URL pública real (SEM barra final). Ex.: https://fechai.januscms.com.br
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Stripe (test mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# IA — provedor ativo é escolhido em /admin/ia (persistido no banco).
# Gemini é o padrão (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional — só se for usar um modelo OpenAI no catálogo.
OPENAI_API_KEY=""

# WhatsApp (Evolution API — gateway self-hosted, ver docker-compose.yml)
# AUTHENTICATION_API_KEY da instância (o "token" do gateway). Mesmo valor no
# docker-compose.evolution.yml local e no serviço "evolution" de produção.
# Em docker-compose.yml o "web"/"worker" usam http://evolution:8080 (rede interna)
# — o valor abaixo é para o desenvolvimento local.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
# Opcionais — configuração do serviço "evolution"/"evolution-postgres" no compose.
EVOLUTION_PORT=8080
EVOLUTION_PUBLIC_URL=""
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution
EVOLUTION_DB_NAME=evolution
# Para o app RECEBER mensagens reais, aponte para o webhook do fechai e ligue.
EVOLUTION_WEBHOOK_ENABLED=false
EVOLUTION_WEBHOOK_URL=""

# Jobs
# Local (fora do Docker): aponta pro Redis do `npm run db:up`.
# Em docker-compose.yml: sobrescrito para redis://redis:6379 (rede interna).
REDIS_URL="redis://localhost:6379"

# BunnyCDN — Storage Zone dedicada do fechai (arquivos da base de conhecimento
# dos clientes + o widget.js de cada tenant, publicado sozinho — ver
# src/lib/widget/deploy.ts). Passo a passo de criação no painel: ver README ou
# pedir pro assistente.
BUNNY_HOST="storage.bunnycdn.com"
BUNNY_STORAGE_ZONE=""
BUNNY_ACCESS_KEY=""
BUNNY_PULL_ZONE=""
# Mesmo valor de BUNNY_PULL_ZONE, mas público (embutido no HTML do snippet
# de instalação) — por isso o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_BUNNY_PULL_ZONE=""
# API Key de CONTA (painel Bunny → ícone do perfil → Account Settings → API) —
# diferente da AccessKey acima. Sem ela, uploads funcionam mas o cache de 30
# dias da pull zone não é purgado ao republicar um arquivo (ex.: widget.js).
BUNNY_API_KEY=""

# Google Agenda (OPCIONAL) — só para o cliente espelhar os horários marcados
# pelo agente na agenda dele. Sem isto, a Agenda do fechai funciona normalmente,
# só não aparece o botão de conectar.
# Passo a passo: console.cloud.google.com → criar projeto → "APIs e serviços" →
# ativar "Google Calendar API" → "Tela de permissão OAuth" (tipo Externo, escopos
# .../auth/calendar.events e .../auth/userinfo.email) → "Credenciais" → criar
# "ID do cliente OAuth" do tipo "Aplicativo da Web" → em "URIs de redirecionamento
# autorizados" cole EXATAMENTE a URL abaixo:
#   http://localhost:3001/api/integrations/google/callback   (desenvolvimento)
#   https://SEU-DOMINIO/api/integrations/google/callback     (produção)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Só preencha se a URL de retorno do OAuth for diferente de NEXTAUTH_URL —
# por padrão ela é derivada dela + /api/integrations/google/callback.
GOOGLE_REDIRECT_URI=""

# Worker de follow-up (workers/follow-up-worker) — opcionais, valores padrão no código.
FOLLOWUP_DELAY_MINUTES=1440
FOLLOWUP_SCAN_EVERY_MINUTES=15

# --- Docker / produção (docker-compose.yml) ---
# Credenciais do container Postgres. POSTGRES_PASSWORD é obrigatório (sem default).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""
POSTGRES_DB=saas
# Portas no host (loopback) dos serviços — usadas só pra debug via SSH no servidor
# (psql, redis-cli). Se 5433/6379 já estiverem ocupadas na VPS, troque por portas
# livres. Não afeta o tráfego externo (o app usa a rede interna do compose).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
