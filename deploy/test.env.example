# Copie este arquivo para /var/www/Fechai/.env.test-vps na VPS.
# O arquivo real é ignorado pelo Git e nunca deve ser commitado.

# Crie um registro DNS A apontando este domínio para a mesma VPS do Traefik.
TEST_APP_DOMAIN=teste.fechai.januscms.com.br

# Use valores exclusivos do laboratório. Hex evita caracteres que quebram URL.
# Gerar senha: openssl rand -hex 32
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_HOST_PORT=5434
TEST_REDIS_HOST_PORT=6380

# Gerar segredo: openssl rand -base64 48
TEST_AUTH_SECRET=

# Segunda barreira antes da tela de login. Gere na VPS (troque a senha):
# docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'SENHA-FORTE' | sed 's/\$/\$\$/g'
# Cole a linha inteira depois do =. Os $$ são necessários no Docker Compose.
TEST_BASIC_AUTH=

# Integrações são opcionais e não herdam produção. Use somente chaves de teste.
TEST_GEMINI_API_KEY=
TEST_OPENAI_API_KEY=
TEST_XAI_API_KEY=
TEST_GROQ_API_KEY=
TEST_STRIPE_SECRET_KEY=
TEST_STRIPE_WEBHOOK_SECRET=
TEST_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp permanece desligado por padrão. Se habilitar futuramente, use uma
# Evolution e um número exclusivos do laboratório.
TEST_EVOLUTION_API_URL=
TEST_EVOLUTION_API_KEY=
TEST_WHATSAPP_WEBHOOK_SECRET=

TEST_FISH_AUDIO_API_KEY=
# Use chave de criptografia própria; não copie a de produção.
TEST_ENCRYPTION_KEY=
TEST_RESEND_API_KEY=
TEST_MAIL_FROM=
TEST_BUNNY_HOST=
TEST_BUNNY_STORAGE_ZONE=
TEST_BUNNY_ACCESS_KEY=
TEST_BUNNY_PULL_ZONE=
TEST_NEXT_PUBLIC_BUNNY_PULL_ZONE=
TEST_BUNNY_API_KEY=
TEST_GOOGLE_CLIENT_ID=
TEST_GOOGLE_CLIENT_SECRET=
TEST_AUTH_GOOGLE_ID=
TEST_AUTH_GOOGLE_SECRET=
