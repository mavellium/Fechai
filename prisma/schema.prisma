// Prisma schema — fechai: SaaS de agente de WhatsApp com IA (MVP)
// Regra multi-tenant: TODA query filtra por tenantId (ver src/lib/prisma + repositórios).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  OWNER // dono do tenant (usuário comum do SaaS)
  SUPERADMIN // admin do painel (admin)/
}

enum PlanKey {
  FREE
  STARTER
  PRO
  BUSINESS
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  planKey          PlanKey           @default(FREE)
  status           String            @default("active") // active | suspended
  createdAt        DateTime          @default(now())

  // Limite de conversas/mês: null = usa o teto do plano (`conversationsPerMonth`).
  // Preenchido pelo superadmin em /admin/contas para dar um teto diferente do
  // plano — usado pelo enforcement (runAgentTurn) e pelos indicadores de uso.
  conversationLimitOverride Int?

  // Teto de respostas da IA por conversa/mês: null = deriva do limite efetivo
  // de conversas (× 3). Override próprio permite o admin fixar as duas cotas
  // independentes — a conta (conversas) e o uso por conversa (respostas).
  perConversationCapOverride Int?

  // Onboarding guiado (/onboarding). Enquanto `onboardingCompleted` for false, o
  // dashboard redireciona para o wizard; `onboardingStep` + `onboardingDraft`
  // permitem retomar de onde o usuário parou.
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(1)
  onboardingDraft     Json?

  // Personalização do widget de chat instalado no site do cliente. Cada tenant
  // tem seu próprio widget.js publicado na CDN (ver src/lib/widget/deploy.ts),
  // gerado automaticamente — sem comando manual. `widgetDeployedAt` marca se
  // esse arquivo já existe; null = ainda não foi publicado nenhuma vez.
  widgetColor       String    @default("#6d5ef8")
  widgetGreeting    String    @default("Olá! Como posso ajudar?")
  widgetIconType    String    @default("emoji") // "emoji" | "image"
  widgetIconEmoji   String    @default("💬")
  widgetIconUrl     String? // usado quando widgetIconType == "image" (upload via Bunny)
  widgetShape       String    @default("circle") // "circle" | "rounded" | "square"
  widgetBorderColor String? // null = sem borda
  widgetDeployedAt  DateTime?

  // WhatsApp: se verdadeiro (padrão), o agente ignora mensagens de grupos.
  whatsappIgnoreGroups Boolean @default(true)

  users            User[]
  agents           Agent[]
  knowledgeDocs    KnowledgeDocument[]
  actions          TenantAction[]
  whatsappInstance WhatsappInstance?
  leads            Lead[]
  conversations    Conversation[]
  feedbacks        Feedback[]
  appointments     Appointment[]
  calendar         CalendarIntegration?
  leadValues       TenantLeadValue[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(OWNER)
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message   String
  rating    Int? // 1-5, opcional
  status    String   @default("new") // new | read | resolved
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Um agente configurável. Era `AgentConfig` com `tenantId @unique` (um por
/// conta); virou `Agent` (vários por conta, limitado por `maxAgents` do plano).
/// Base de conhecimento e ações passaram a pendurar aqui, não no Tenant: dois
/// agentes da mesma conta atendem contextos diferentes e não podem se
/// contaminar (o de vendas respondendo com documento do suporte).
model Agent {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String   @default("Meu agente")
  systemPrompt String   @default("")
  objective    String   @default("")
  personaDraft Json? // respostas cruas do wizard, para reeditar
  /// Agente que atende o número de WhatsApp da conta. Enquanto o WhatsApp for
  /// um por conta (ver CHANGELOG), exatamente um agente é o principal.
  isPrimary    Boolean  @default(false)
  /// Chave geral do agente. `false` = ele para de responder em qualquer canal
  /// (WhatsApp, widget do site e sandbox) sem perder persona, base nem ações.
  /// Existe porque a única forma de calar um agente era excluí-lo ou desligar
  /// o WhatsApp inteiro — as duas destrutivas demais para uma pausa.
  enabled      Boolean  @default(true)
  /// Ouve mensagens de voz do WhatsApp: o áudio é transcrito e o agente
  /// responde como se fosse texto. Desligado, áudios são ignorados.
  listenAudio  Boolean  @default(true)
  /// Cliente reage com um emoji ou manda só um emoji: a conversa encerra e o
  /// agente para de responder nela (mesmo mecanismo de quando um humano assume
  /// — `agentPaused`). O dono devolve a conversa em /conversas para retomar.
  stopOnEmoji  Boolean  @default(true)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeDocs KnowledgeDocument[]
  actions       TenantAction[]
  conversations Conversation[]
  appointments  Appointment[]

  @@index([tenantId])
}

model KnowledgeDocument {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Documento pertence a UM agente. `tenantId` segue aqui porque a regra de
  // ouro do multi-tenant é toda query filtrar por ele (ver topo do arquivo).
  agentId   String
  agent     Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  content   String
  status    String            @default("pending") // pending | ready | failed | no_embeddings
  // Arquivo original enviado pelo cliente, guardado na BunnyCDN (ver
  // src/lib/bunny.ts). `content` continua sendo o texto extraído — o
  // arquivo em si só existia em memória até aqui e nunca era persistido.
  fileUrl   String?
  fileName  String?
  chunks    KnowledgeChunk[]
  createdAt DateTime          @default(now())

  @@index([tenantId])
  @@index([agentId])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  tenantId   String
  // Desnormalizado do documento para o RAG filtrar por agente direto no SQL
  // cru do pgvector, sem join (ver searchSimilarChunks).
  agentId    String
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // embedding via pgvector (text-embedding-3-small = 1536 dims).
  // Unsupported: gravado/consultado via $queryRaw (ver módulo knowledge-base).
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime          @default(now())

  @@index([documentId])
  @@index([tenantId])
  @@index([agentId])
}

/// Ação habilitada para um agente. O nome segue `TenantAction` por compat, mas
/// o escopo agora é o agente: cada um liga as suas dentro do teto do plano.
model TenantAction {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId  String
  agent    Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key      String // schedule_meeting | mark_hot_lead | register_lead | follow_up | handoff_human
  enabled  Boolean @default(false)
  config   Json?

  @@unique([agentId, key])
  @@index([tenantId])
  @@index([agentId])
}

model WhatsappInstance {
  id         String   @id @default(cuid())
  tenantId   String   @unique
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status     String   @default("disconnected") // disconnected | pending_qr | connected
  externalId String? // id da instância na Evolution API
  updatedAt  DateTime @updatedAt
}

model Lead {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String?
  phone        String
  status       String        @default("new") // new | warm | hot | scheduled | lost
  /// Contato criado pelo chat de teste (sandbox), não por um cliente real.
  /// Fica no banco com histórico permanente (aparece em Conversas, na aba
  /// "Testes"), mas contagem de negócio (contatos, relatórios, home) filtra
  /// `isTest: false` — antes o sandbox inflava o número de leads da conta.
  isTest       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  conversation Conversation?
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, isTest])
}

model Conversation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Qual agente atendeu. `SetNull` (e não Cascade): excluir um agente não pode
  // apagar o histórico de conversas nem os leads que ele gerou.
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId     String    @unique
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages   Message[]
  needsHuman Boolean   @default(false)
  /// Verdadeiro depois que um humano responde manualmente pelo painel
  /// (`sendManualMessage`). Enquanto ligado, `runAgentTurn` não gera resposta
  /// automática NESTA conversa — as outras do mesmo agente continuam normais.
  /// `needsHuman` sozinho não bastava: é só sinalizador de fila, nada no motor
  /// olhava pra ele antes de responder.
  agentPaused Boolean  @default(false)
  /// Espelha `Lead.isTest` para as consultas de conversa não precisarem de join.
  isTest     Boolean   @default(false)
  lastInboundAt DateTime?
  followUpSentAt DateTime?
  updatedAt  DateTime  @updatedAt

  appointments Appointment[]

  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, isTest])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  /// Quem gerou uma mensagem "assistant": "agent" (a IA respondeu sozinha) ou
  /// "human" (o dono da conta respondeu manualmente pelo painel). Null em
  /// mensagens "user"/"system", onde a distinção não existe. Sem isto, uma
  /// resposta manual gravada como "assistant" faria a IA achar que foi ELA
  /// quem disse aquilo nos próximos turnos — `sentBy` deixa `role` intacto
  /// (o histórico que vai pro LLM continua "assistant", que é o que importa
  /// pro contexto) e só a UI e a auditoria usam este campo pra diferenciar.
  sentBy         String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// Um horário marcado com um lead. Nasce de duas formas: o agente usando a
/// ação `schedule_meeting` durante a conversa, ou o usuário marcando à mão em
/// /agenda. Antes `schedule_meeting` era um mock que só trocava o status do
/// lead para "scheduled" — a data combinada não era guardada em lugar nenhum.
model Appointment {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `SetNull` como em Conversation: apagar o agente não apaga a agenda.
  agentId        String?
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  title     String
  notes     String?
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("scheduled") // scheduled | done | canceled
  source    String   @default("agent") // agent | manual
  /// Id do evento espelhado no Google Agenda, quando a conta está integrada.
  /// Null = só existe aqui (integração desligada ou sincronização falhou).
  googleEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt])
  @@index([leadId])
  @@index([agentId])
}

/// Conexão OAuth da conta com o Google Agenda (opcional). Uma por tenant.
/// Os tokens ficam aqui e não em env: são credenciais DO CLIENTE, emitidas no
/// consentimento dele, e cada conta tem as suas.
model CalendarIntegration {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     String   @default("google")
  /// Conta Google conectada — mostrada na tela para a pessoa saber qual é.
  accountEmail String?
  calendarId   String   @default("primary")
  accessToken  String
  /// Só vem no primeiro consentimento; sem ele a conexão morre em 1h.
  refreshToken String?
  expiresAt    DateTime
  /// Espelhar novos agendamentos no Google pode ser desligado sem desconectar.
  syncEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Configuração de IA da PLATAFORMA (não é por tenant) — linha única.
/// Trocada pelo superadmin em /admin/ia; lida por src/modules/ai/settings.ts.
model AiSetting {
  id        String   @id @default("singleton")
  modelId   String // id do modelo no catálogo (src/modules/ai/catalog.ts)
  updatedAt DateTime @updatedAt
  updatedBy String? // e-mail do superadmin que trocou
}

/// Quanto um lead fechado vale para o dono — definido manualmente na visão
/// Financeira de /relatorios. Cada alteração cria uma entrada nova com vigência
/// (`startsAt`): períodos já iniciados usam o valor em vigor no início deles,
/// então mudar o valor não recalcula relatórios passados retroativamente.
model TenantLeadValue {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Em centavos de real (mesma unidade de `Plan.priceCents`).
  valueCents Int
  /// Entra em vigor a partir desta data/hora.
  startsAt   DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, startsAt])
}
